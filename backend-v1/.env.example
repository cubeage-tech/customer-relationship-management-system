# Backend environment variables, taken from the ${...} placeholders in
# src/main/resources/application.properties. Values are left blank on purpose:
# set real values in the deployment environment, never in this file.
#
# Spring Boot does not load .env files by itself. Set these as real OS/container
# environment variables (e.g. docker-compose `environment:` or your host's settings).
# The database connection (spring.datasource.*) is not env-driven yet — see ISS-004.

# Security
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=
CORS_ALLOWED_ORIGINS=

# Links in outgoing emails
FRONTEND_URL=

# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Payments
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Seeded platform super admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Subscriptions
SUBSCRIPTION_TRIAL_PLAN=
SUBSCRIPTION_TRIAL_DAYS=
SUBSCRIPTION_GRACE_DAYS=
SUBSCRIPTION_STATUS_REFRESH_CRON=

# Logging (defaults: SQL logging off, INFO; set SHOW_SQL=true / APP_LOG_LEVEL=DEBUG locally if needed)
SHOW_SQL=
APP_LOG_LEVEL=

# Features and limits
FEATURE_SALES_TEAM_SCOPE=
PAGINATION_DEFAULT_SIZE=
PAGINATION_MAX_SIZE=
QUOTATION_DISCOUNT_THRESHOLD=

# Service ticket SLA (hours)
TICKET_SLA_HOURS_CRITICAL=
TICKET_SLA_HOURS_HIGH=
TICKET_SLA_HOURS_MEDIUM=
TICKET_SLA_HOURS_LOW=
