# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API base URL (see core/services/interceptor.service.js).
# Origin only, no path: serverUrl.constant.js already carries the /auth and /api
# prefixes, and the backend serves them from the root (server.servlet.context-path
# is commented out in application.properties). A wrong prefix here makes every
# request 401 and the interceptor logs you out right after signing in.
VITE_API_URL=http://localhost:8080

# Firebase project config (see firebase/firebase.js)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development login (see core/services/auth.service.js).
# Only takes effect under `vite dev` — Vite hardcodes import.meta.env.DEV to
# false in production builds, so this can never activate a real deployment
# no matter what value ships in its .env. Lets you sign in as any of the 7
# seed CRM roles in src/core/mocks/devUsers.js without a running backend.
# Keep this off when the backend is running: the mock path returns a fake
# "dev-mock-token" that the Spring JwtAuthFilter rejects, so login succeeds and
# then the first real API call bounces you back to /login.
VITE_ENABLE_MOCK_AUTH=false
VITE_DEV_LOGIN_PASSWORD=Dev@12345
